---
import EasyLayout from '../layouts/EasyLayout.astro';
import '../styles/site.css';
import UtilityBar from '../components/layout/UtilityBar.astro';
import SiteHeader from '../components/layout/SiteHeader.astro';
import HeroSection from '../components/sections/HeroSection.astro';
import ManifestoStrip from '../components/sections/ManifestoStrip.astro';
import ServicesSection from '../components/sections/ServicesSection.astro';
import SegmentsSection from '../components/sections/SegmentsSection.astro';
import AboutSection from '../components/sections/AboutSection.astro';
import TeamSection from '../components/sections/TeamSection.astro';
import Marquee from '../components/ui/Marquee.astro';
import BenefitsSection from '../components/sections/BenefitsSection.astro';
import FaqSection from '../components/sections/FaqSection.astro';
import ContactSection from '../components/sections/ContactSection.astro';
import SiteFooter from '../components/layout/SiteFooter.astro';
import FloatingContact from '../components/layout/FloatingContact.astro';
---

<EasyLayout
  title="EASY Contabilidade Digital — Mais simples para sua empresa"
  description="EASY Contabilidade Digital em Guarapari. Abertura de empresa, MEI, migração para ME, troca de contador e certificado digital. Converse pelo WhatsApp."
>
  <a href="#conteudo" class="skip">Pular para o conteúdo</a>
  <UtilityBar />
  <SiteHeader />

  <main id="conteudo">
    <HeroSection />
    <ManifestoStrip />
    <ServicesSection />
    <SegmentsSection />
    <AboutSection />
    <TeamSection />
    <Marquee />
    <BenefitsSection />
    <FaqSection />
    <ContactSection />
  </main>

  <SiteFooter />
  <FloatingContact />
  <script>import '../scripts/site.js';</script>
</EasyLayout>
