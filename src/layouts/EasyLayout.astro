---
import '../styles/brand.css';
import { getImage } from 'astro:assets';
import favicon from '../assets/images/easy-profile.png';
import montserratUrl from '../assets/fonts/montserrat-latin.woff2?url';
import mulishUrl from '../assets/fonts/mulish-latin.woff2?url';

interface Props {
  title: string;
  description: string;
  themeColor?: string;
  page?: 'site' | 'catalog';
}

const { title, description, themeColor = '#7b3f9f', page = 'site' } = Astro.props;
const faviconImage = await getImage({ src: favicon, width: 64, height: 64, format: 'png' });
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content={themeColor} />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <link rel="icon" type="image/png" href={faviconImage.src} />
    <link rel="preload" href={montserratUrl} as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="preload" href={mulishUrl} as="font" type="font/woff2" crossorigin="anonymous" />
  </head>
  <body class={page === 'catalog' ? 'catalog-page' : 'site-page'}>
    <slot />
  </body>
</html>
