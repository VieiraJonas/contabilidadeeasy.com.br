---
import { Image } from 'astro:assets';
import wordmark from '../../assets/images/easy-wordmark.png';

interface Props {
  href?: string;
}
const { href = '#inicio' } = Astro.props;
---

<a class="wordmark" href={href} aria-label="EASY Contabilidade Digital, início">
  <Image src={wordmark} alt="EASY contabilidade digital" width={200} widths={[100, 200, 300]} sizes="100px" format="webp" quality={75} loading="lazy" decoding="async" />
</a>
