---
import { iconPaths, symbolIcons, type IconName } from '../../lib/icons';

interface Props {
  name?: IconName;
  symbol?: string;
  class?: string;
}

const { name, symbol, class: className } = Astro.props;
const resolvedName = name ?? (Object.hasOwn(symbolIcons, symbol ?? '') ? symbolIcons[symbol ?? ''] : undefined);
if (!resolvedName) throw new Error(`Unknown EASY icon: ${symbol ?? name}`);
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  width="1em"
  height="1em"
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  class:list={['easy-icon', className]}
  data-icon={resolvedName}
  aria-hidden="true"
  focusable="false"
>
  <path d={iconPaths[resolvedName]} />
</svg>
